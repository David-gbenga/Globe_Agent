# Copy to .env and source it, or export directly.

# --- LLM provider (default: azure) ---
# GLOBE_LLM_PROVIDER=azure
# GLOBE_LLM_PROVIDER=anthropic

# Model or deployment name (provider-specific).
GLOBE_MODEL=gpt-5-nano

# Set to 1 to run entirely offline with the fake LLM.
# Useful for checking the pipeline; useless for evaluating quality.
GLOBE_FAKE=0

# --- Azure OpenAI (when GLOBE_LLM_PROVIDER=azure) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=

# --- Anthropic (when GLOBE_LLM_PROVIDER=anthropic) ---
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# ANTHROPIC_API_VERSION=2023-06-01

# Optional: if python.org 3.13 fails SSL verification on your network, try:
# SSL_CERT_FILE=/opt/homebrew/etc/openssl@3/cert.pem
